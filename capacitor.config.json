{
  "appId": "com.onethumbarcade.thread",
  "appName": "THREAD",
  "webDir": "dist",
  "backgroundColor": "#02040b",
  "server": {
    "appStartPath": "/update-2-preview.html",
    "hostname": "localhost",
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": false,
    "useLegacyBridge": true
  },
  "ios": {
    "contentInset": "automatic"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "launchShowDuration": 0,
      "backgroundColor": "#02040b",
      "showSpinner": false
    },
    "SystemBars": {
      "style": "DARK",
      "insetsHandling": "css"
    }
  }
}
